<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rabbitmq_host_config" model="ir.config_parameter">
            <field name="key">poc_processing_tasks.rabbitmq_host</field>
            <field name="value">rabbitmq</field>
        </record>
        <record id="rabbitmq_port_config" model="ir.config_parameter">
            <field name="key">poc_processing_tasks.rabbitmq_port</field>
            <field name="value">5672</field>
        </record>
        <record id="rabbitmq_user_config" model="ir.config_parameter">
            <field name="key">poc_processing_tasks.rabbitmq_user</field>
            <field name="value">user</field>
        </record>
        <record id="rabbitmq_pass_config" model="ir.config_parameter">
            <field name="key">poc_processing_tasks.rabbitmq_pass</field>
            <field name="value">password</field>
        </record>
        <record id="rabbitmq_queue_name_config" model="ir.config_parameter">
            <field name="key">poc_processing_tasks.rabbitmq_queue_name</field>
            <field name="value">payroll_tasks</field>
        </record>
    </data>
</odoo>
